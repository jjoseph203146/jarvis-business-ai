# JARVIS Business AI Assistant Configuration

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe Integration
STRIPE_API_KEY=sk_live_your_stripe_secret_key_here

# Gmail Integration (OAuth2)
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URL=http://localhost:3001/auth/gmail/callback

# Luminate OS API
LUMINATE_OS_API_KEY=your_luminate_os_api_key_here
LUMINATE_OS_BASE_URL=https://api.luminateos.com

# Server Configuration
PORT=3001
NODE_ENV=development
